{
  "mcpServers": {
    "goofish-yao": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "goofish-yao-cli==0.7.0",
        "goofish-yao-cli"
      ],
      "connectionTimeoutMs": 120000,
      "requestTimeoutMs": 120000,
      "supportsParallelToolCalls": false,
      "toolFilter": {
        "exclude": [
          "auth_login",
          "auth_reset_guard",
          "message_watch",
          "skills_install"
        ]
      }
    }
  }
}
